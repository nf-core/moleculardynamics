/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/moleculardynamics -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data
    // Keep this dataset very small for fast CI smoke tests.
    // Path convention in nf-core/test-datasets (Option B):
    //   moleculardynamics/testdata/samplesheet/v1.0/samplesheet_test.csv
    input             = params.pipelines_testdata_base_path + 'moleculardynamics/testdata/samplesheet/v1.0/samplesheet_test.csv'
    gromacs_container = 'quay.io/biocontainers/gromacs:2022'
    gromacs_conda     = 'bioconda::gromacs=2022'
    gmx_cmd           = 'gmx'
}
