/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

//
// General configuration options
//

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: '(PDB|GROMACS)_.*' {
        container   = params.gromacs_container
        conda       = params.gromacs_conda
        ext.gmx_cmd = { params.gmx_cmd }
    }

    //
    // Pre-processing
    //
    withName: 'PDB_CLEAN' {
        ext.prefix = { "${meta.id}_cleaned" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/preprocessing" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'PDB_CHECKMISSING' {
        ext.prefix = { "${meta.id}_checked" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/preprocessing" },
            mode: params.publish_dir_mode
        ]
    }

    //
    // Topology and solvation
    //
    withName: 'GROMACS_PDB2GMX' {
        ext.args   = '-i posre.itp -ignh'
        publishDir = [
            path: { "${params.outdir}/${meta.id}/topology" },
            mode: params.publish_dir_mode
        ]
    }

    // editconf options come from the samplesheet; empty cells get the defaults declared in assets/schema_input.json
    withName: 'GROMACS_EDITCONF' {
        ext.args   = { "-c -d ${meta.distance_to_box} -bt ${meta.box_type}" }
        ext.prefix = { "${meta.id}_box" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/solvation" },
            mode: params.publish_dir_mode
        ]
    }

    // topol.top is published once, by GROMACS_GENION
    withName: 'GROMACS_SOLVATE' {
        ext.args   = { "-cs ${params.water_coordinates}" }
        ext.prefix = { "${meta.id}_box_solv" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/solvation" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('.top') ? null : filename }
        ]
    }

    withName: 'GROMACS_GROMPP_IONS' {
        ext.prefix = 'ions'
        publishDir = [
            path: { "${params.outdir}/${meta.id}/solvation" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'GROMACS_GENION' {
        ext.args   = { "-neutral -conc ${params.ion_concentration} -pname NA -nname CL" }
        ext.prefix = { "${meta.id}_box_solv_ions" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/solvation" },
            mode: params.publish_dir_mode
        ]
    }

    //
    // Energy minimisation, equilibration and production. Output files are named after the MDP file.
    //
    withName: '.*:GROMPP_MDRUN_.*:GROMACS_GROMPP' {
        ext.prefix = { mdp.simpleName }
    }

    withName: '.*:GROMPP_MDRUN_.*:GROMACS_MDRUN' {
        ext.args   = '-v'
        ext.prefix = { tpr.baseName }
    }

    withName: '.*:GROMPP_MDRUN_EM:GROMACS_.*' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/energy_minimization" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('.xtc') ? null : filename }
        ]
    }

    withName: '.*:GROMPP_MDRUN_NVT:GROMACS_.*' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/nvt_equilibration" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('.xtc') ? null : filename }
        ]
    }

    withName: '.*:GROMPP_MDRUN_NPT:GROMACS_.*' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/npt_equilibration" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('.xtc') ? null : filename }
        ]
    }

    withName: '.*:GROMPP_MDRUN_PRODUCTION:GROMACS_.*' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/production" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'GROMACS_REPORTMETHODS' {
        ext.prefix = 'MD_REPORT'
        publishDir = [
            path: { "${params.outdir}/${meta.id}/production" },
            mode: params.publish_dir_mode
        ]
    }

    //
    // Post-processing and analysis
    //
    withName: 'GROMACS_TRJCONV' {
        ext.args   = '-pbc mol -center'
        ext.prefix = 'md_noPBC'
        publishDir = [
            path: { "${params.outdir}/${meta.id}/post_processing" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'GROMACS_RMS' {
        ext.args   = '-tu ns'
        ext.prefix = 'rmsd'
        publishDir = [
            path: { "${params.outdir}/${meta.id}/analysis" },
            mode: params.publish_dir_mode
        ]
    }
}
